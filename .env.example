# Frontend runtime mode.
# Local development defaults to demo when this value is omitted.
# Production defaults to connected and fails closed when required API/auth
# bindings are unavailable.
VITE_RUNTIME_MODE="demo"

# Connected API configuration. Required when VITE_RUNTIME_MODE=connected.
# VITE_API_BASE_URL="https://api.example.com/v1"
# Operation paths are generated from OpenAPI and cannot be overridden by frontend environment variables.
# VITE_API_TIMEOUT_MS="15000"

# Frontend authentication adapter.
# `development` is allowed only for local/demo use. Production must install a
# server-backed identity/workspace integration and expose
# window.__UNICORECRM_CONNECTED_RUNTIME__.getAccessToken plus getWorkspaceId
# before the app bundle. Optional callbacks: refreshSession, onUnauthorized,
# logout and telemetry. The host never supplies application services.
VITE_AUTH_ADAPTER="development"

# Optional external identity entry points. These may be absolute URLs or
# deployment-relative paths owned by the configured identity provider.
# VITE_AUTH_GOOGLE_URL="/auth/google"
# VITE_AUTH_MICROSOFT_URL="/auth/microsoft"

# Explicit escape hatch for a deliberately published demo build. Do not enable
# this for a production environment connected to real customer data.
# VITE_ALLOW_PRODUCTION_DEMO="false"

# Optional development tooling switch used by vite.config.ts.
# DISABLE_HMR="false"
